<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/surface"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Programme 1: Text Color Changer"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailPackage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="com.example.myapplication1"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyAllFiles"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="@color/primary"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Copy All"
                android:textAllCaps="false"
                android:textColor="@color/on_primary"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_copy_all"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="@color/on_primary" />
        </LinearLayout>

        <!-- Programme Note/Banner if applicable -->
        <LinearLayout
            android:id="@+id/layoutNoticeBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_badge_extra"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvNoticeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="#B45309"
                android:textSize="12sp"
                android:lineSpacingExtra="1.5dp" />
        </LinearLayout>

        <!-- File Tabs / Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="6dp"
                android:text="@string/select_file"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFileChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </LinearLayout>

        <!-- Active File Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCurrentFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MainActivity.java"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCurrentFilePath"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:text="app/src/main/java/com/example/myapplication1/MainActivity.java"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Font size controls -->
            <ImageButton
                android:id="@+id/btnZoomOut"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Zoom out"
                android:src="@drawable/ic_clear"
                android:scaleType="centerInside"
                android:padding="6dp"
                app:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btnZoomIn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Zoom in"
                android:src="@drawable/ic_search"
                android:scaleType="centerInside"
                android:padding="6dp"
                app:tint="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyActiveFile"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/surface"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Copy Code"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_copy"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="@color/primary"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- Code Viewer Box -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="14dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/code_background"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/code_border"
            app:strokeWidth="1dp">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollCodeVertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <HorizontalScrollView
                    android:id="@+id/scrollCodeHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Line Numbers Gutter -->
                        <TextView
                            android:id="@+id/tvLineNumbers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@color/code_gutter_background"
                            android:fontFamily="monospace"
                            android:gravity="end"
                            android:lineSpacingExtra="3dp"
                            android:paddingStart="10dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="16dp"
                            android:text="1\n2\n3"
                            android:textColor="@color/code_gutter_text"
                            android:textSize="13sp" />

                        <!-- Divider line -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/code_border" />

                        <!-- Code Content -->
                        <TextView
                            android:id="@+id/tvCodeContent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:lineSpacingExtra="3dp"
                            android:paddingStart="12dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="24dp"
                            android:paddingBottom="16dp"
                            android:text="// Loading source code..."
                            android:textColor="@color/code_text"
                            android:textIsSelectable="true"
                            android:textSize="13sp" />
                    </LinearLayout>
                </HorizontalScrollView>
            </androidx.core.widget.NestedScrollView>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
